# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Supabase Storage bucket used for uploaded and generated project images
SUPABASE_STORAGE_BUCKET=project-assets

# Only needed by local maintenance scripts under scripts/ (never exposed to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Kie AI image generation API
KIE_API_BASE_URL=https://api.kie.ai
KIE_API_KEY=your-kie-api-key

# DeepSeek model used by Pi Agent (server-side only)
# Official first-call params: https://api-docs.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
